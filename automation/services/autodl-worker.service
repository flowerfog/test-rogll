[Unit]
Description=ROGII AutoDL experiment worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autolab
WorkingDirectory=/opt/rogii-automation
ExecStart=/usr/bin/python3 /opt/rogii-automation/automation/autodl_worker.py --config /etc/autolab/autodl.toml
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
