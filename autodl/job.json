{
  "version": 1,
  "job_id": "rogii_suffix_torch_mlp_v1",
  "enabled": true,
  "command": [
    "python",
    "train_eval.py",
    "--folds",
    "5",
    "--max-train-rows-per-well",
    "512",
    "--max-iter",
    "120",
    "--batch-size",
    "8192",
    "--hidden-width",
    "128",
    "--device",
    "cuda",
    "--metrics-output",
    "output/metrics.json"
  ],
  "timeout_seconds": 21600,
  "gpu": "0",
  "artifacts": [
    "output/metrics.json"
  ],
  "metrics_file": "output/metrics.json",
  "notes": "CUDA PyTorch MLP residual baseline with grouped pooled-RMSE OOF.",
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
